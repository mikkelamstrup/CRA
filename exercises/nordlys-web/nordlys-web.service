[Unit]
Description=Nordlys read-only teaching website
[Service]
WorkingDirectory=/home/crauser/nordlys-web
ExecStart=/usr/bin/python3 /home/crauser/nordlys-web/server.py
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
MemoryMax=96M
TasksMax=32
CPUQuota=50%
LimitNOFILE=128
[Install]
WantedBy=default.target
